c:["$","div","443",{"className":"bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow border border-gray-100 flex flex-col overflow-hidden","children":[["$","$L2",null,{"href":"/product/cute-mini-portable-rechargeable-fan-with-detachable-dock-usb-handheld-desktop-cooling-fan","className":"block relative w-full pt-[100%] bg-gray-50 group","children":["$","$L3",null,{"src":"https://admin.gadgetmartbd.shop/wp-content/uploads/2026/04/Picsart_26-04-04_17-18-37-550.jpg","alt":"Cute Mini Portable Rechargeable Fan with Detachable Dock – USB Handheld & Desktop Cooling Fan","fill":true,"className":"object-contain p-3 group-hover:scale-105 transition-transform"}]}],["$","div",null,{"className":"p-3 flex flex-col flex-grow","children":[["$","$L2",null,{"href":"/product/cute-mini-portable-rechargeable-fan-with-detachable-dock-usb-handheld-desktop-cooling-fan","children":["$","h3",null,{"className":"text-sm font-bold text-gray-800 line-clamp-2 hover:text-teal-600 transition-colors mb-1","dangerouslySetInnerHTML":{"__html":"Cute Mini Portable Rechargeable Fan with Detachable Dock – USB Handheld & Desktop Cooling Fan"}}]}],["$","div",null,{"className":"mt-auto pt-2","children":[["$","div",null,{"className":"text-teal-600 font-extrabold text-lg mb-2","children":["৳ ","399"]}],["$","$L4",null,{"product":{"id":443,"name":"Cute Mini Portable Rechargeable Fan with Detachable Dock – USB Handheld & Desktop Cooling Fan","slug":"cute-mini-portable-rechargeable-fan-with-detachable-dock-usb-handheld-desktop-cooling-fan","permalink":"https://admin.gadgetmartbd.shop/product/cute-mini-portable-rechargeable-fan-with-detachable-dock-usb-handheld-desktop-cooling-fan/","date_created":"2026-04-04T17:19:28","date_created_gmt":"2026-04-04T11:19:28","date_modified":"2026-08-22T21:09:12","date_modified_gmt":"2026-08-22T15:09:12","type":"simple","status":"publish","featured":false,"catalog_visibility":"visible","description":"<p>এই Cute Mini Portable Fanটি একটি স্টাইলিশ ও কমপ্যাক্ট কুলিং ডিভাইস, যা গরমের দিনে আপনাকে তাৎক্ষণিক স্বস্তি দেবে। এর ডিট্যাচেবল ডক ডিজাইনের কারণে এটি আপনি হাতে ব্যবহার করতে পারবেন আবার সহজেই ডেস্ক ফ্যান হিসেবেও ব্যবহার করা যায়।<br />\nফ্যানটিতে রয়েছে বিল্ট-ইন রিচার্জেবল ব্যাটারি এবং USB চার্জিং সাপোর্ট, ফলে আপনি পাওয়ার ব্যাংক, ল্যাপটপ বা অ্যাডাপ্টার দিয়ে সহজেই চার্জ দিতে পারবেন। এতে একাধিক স্পিড মোড রয়েছে, যা প্রয়োজন অনুযায়ী বাতাসের গতি নিয়ন্ত্রণ করতে সাহায্য করে।<br />\nলাইটওয়েট ও ছোট সাইজ হওয়ায় এটি সহজে বহনযোগ্য—ব্যাগে রেখে যেকোনো জায়গায় নিয়ে যেতে পারবেন। বাসা, অফিস, পড়াশোনা, ভ্রমণ কিংবা আউটডোর—সব জায়গায় ব্যবহারের জন্য এটি পারফেক্ট।<br />\nমূল বৈশিষ্ট্যসমূহ:<br />\nহ্যান্ডহেল্ড ও ডেস্কটপ ২-ইন-১ ডিজাইন<br />\nডিট্যাচেবল ডক/স্ট্যান্ড সুবিধা<br />\nUSB রিচার্জেবল ব্যাটারি<br />\nএকাধিক স্পিড কন্ট্রোল<br />\nলাইটওয়েট ও পোর্টেবল<br />\nস্টাইলিশ ও কিউট লুক<br />\nগরমে ব্যক্তিগত কুলিংয়ের জন্য এটি একটি স্মার্ট ও ট্রেন্ডি সমাধান 🌬️</p>\n","short_description":"","sku":"","price":"399","regular_price":"700","sale_price":"399","date_on_sale_from":null,"date_on_sale_from_gmt":null,"date_on_sale_to":null,"date_on_sale_to_gmt":null,"on_sale":true,"purchasable":true,"total_sales":1,"virtual":false,"downloadable":false,"downloads":[],"download_limit":-1,"download_expiry":-1,"external_url":"","button_text":"","tax_status":"taxable","tax_class":"","manage_stock":false,"stock_quantity":null,"backorders":"no","backorders_allowed":false,"backordered":false,"low_stock_amount":null,"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"shipping_required":true,"shipping_taxable":true,"shipping_class":"","shipping_class_id":0,"reviews_allowed":true,"average_rating":"0.00","rating_count":0,"upsell_ids":[],"cross_sell_ids":[],"parent_id":0,"purchase_note":"","categories":[{"id":32,"name":"Mini fan","slug":"fan"}],"brands":[],"tags":[],"images":[{"id":444,"date_created":"2026-04-04T17:18:54","date_created_gmt":"2026-04-04T11:18:54","date_modified":"2026-04-04T17:18:54","date_modified_gmt":"2026-04-04T11:18:54","src":"https:/